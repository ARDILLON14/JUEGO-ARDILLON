-- Pruebas de la fase 2: puntos, reinicio, valores derivados, niveles, energía y monedas.

local Shared = game:GetService("ReplicatedStorage").Shared
local Server = game:GetService("ServerScriptService").Server
local Estadisticas = require(Shared.Reglas.Estadisticas)
local Niveles = require(Shared.Reglas.Niveles)
local Progresion = require(Shared.Formulas.Progresion)
local Economia = require(Shared.Formulas.Economia)
local Recursos = require(Server.Reglas.Recursos)
local Monedero = require(Server.Reglas.Monedero)
local PlantillaPerfil = require(Server.Datos.PlantillaPerfil)

local function perfil(nivel)
	local p = PlantillaPerfil.nuevo(0)
	p.Progress.Level = nivel or 1
	p.Progress.UnlockedZone = Niveles.zonaPorNivel(p.Progress.Level)
	return p
end

return function(t)
	t.describe("Puntos de estadística", function()
		t.it("3 al empezar y 3 por nivel; los de renacimiento se suman", function()
			t.equal(Estadisticas.puntosLibres(perfil(1)), 3)
			t.equal(Estadisticas.puntosLibres(perfil(500)), 1500)
			local p = perfil(10)
			p.Stats.BonusPoints = 20
			t.equal(Estadisticas.puntosLibres(p), 50)
		end)
		t.it("asignar resta puntos libres", function()
			local p = perfil(10)
			t.ok(Estadisticas.asignar(p, "Strength", 10))
			t.ok(Estadisticas.asignar(p, "Luck", 20))
			t.equal(Estadisticas.puntosLibres(p), 0)
			t.equal(p.Stats.Allocated.Strength, 10)
			t.equal(select(2, Estadisticas.asignar(p, "Luck", 1)), "sin_puntos")
		end)
		t.it("rechaza estadísticas y cantidades no válidas", function()
			local p = perfil(10)
			t.equal(select(2, Estadisticas.asignar(p, "Agilidad", 1)), "estadistica")
			t.equal(select(2, Estadisticas.asignar(p, "Luck", 0)), "cantidad")
			t.equal(select(2, Estadisticas.asignar(p, "Luck", 1.5)), "cantidad")
			t.equal(select(2, Estadisticas.asignar(p, "Luck", -3)), "cantidad")
			t.equal(Estadisticas.puntosAsignados(p), 0)
		end)
		t.it("máximo de 1.000 puntos por estadística", function()
			local p = perfil(1000)
			t.ok(Estadisticas.asignar(p, "Mining", 1000))
			t.equal(select(2, Estadisticas.asignar(p, "Mining", 1)), "tope")
			t.equal(Estadisticas.maximoAsignable(p, "Mining"), 0)
			t.equal(Estadisticas.maximoAsignable(p, "Luck"), 1000)
			t.equal(Estadisticas.maximoAsignable(perfil(2), "Luck"), 6)
		end)
		t.it("a nivel 1.000 se pueden llevar al tope 3 de las 8", function()
			t.equal(math.floor(Estadisticas.puntosTotales(perfil(1000)) / 1000), 3)
		end)
	end)

	t.describe("Reinicio", function()
		t.it("gratis por debajo del nivel 50", function()
			t.equal(Estadisticas.costeReinicio(perfil(49)), 0)
		end)
		t.it("desde el nivel 50 cuesta 1,5 horas de ingreso de la zona desbloqueada", function()
			t.equal(Estadisticas.costeReinicio(perfil(50)), math.floor(1.5 * Economia.income(1) + 0.5))
			t.equal(Estadisticas.costeReinicio(perfil(450)), math.floor(1.5 * Economia.income(5) + 0.5))
		end)
		t.it("devuelve todos los puntos", function()
			local p = perfil(100)
			Estadisticas.asignar(p, "Strength", 100)
			Estadisticas.asignar(p, "Speed", 50)
			t.equal(Estadisticas.reiniciarPuntos(p), 150)
			t.equal(Estadisticas.puntosAsignados(p), 0)
			t.equal(Estadisticas.puntosLibres(p), 300)
		end)
	end)

	t.describe("Valores derivados", function()
		t.it("sin puntos", function()
			local d = Estadisticas.derivadas(perfil(1))
			t.equal(d.MaxHealth, 500)
			t.equal(d.MaxEnergy, 100)
			t.equal(d.WalkSpeed, 16)
			t.equal(d.Damage, 1)
			t.equal(d.Luck, 1)
			t.equal(d.DefensePvE, 0)
			t.equal(d.BlinkUnlocked, false)
		end)
		t.it("con 1.000 puntos (tabla de B2)", function()
			local p = perfil(1000)
			for _, s in ipairs({ "Vitality", "Energy", "Speed" }) do
				p.Stats.Allocated[s] = 1000
			end
			local d = Estadisticas.derivadas(p)
			t.near(d.MaxHealth, Progresion.baseHealth(1000) * 2.5)
			t.near(d.MaxHealthPvP, Progresion.baseHealth(1000) * 1.5)
			t.near(d.MaxEnergy, 250)
			t.near(d.EnergyRegenCombat, 12)
			t.near(d.EnergyRegenIdle, 30)
			t.near(d.WalkSpeed, 20)
			t.near(d.AttackSpeed, 1.4)
			t.equal(d.BlinkUnlocked, true)
		end)
		t.it("los bonos se suman a los puntos y el total se limita a 5.000", function()
			local p = perfil(1000)
			p.Stats.Allocated.Strength = 1000
			local d = Estadisticas.derivadas(p, { Strength = 9000, Defense = 1500 })
			t.equal(d.Effective.Strength, 5000)
			t.near(d.Damage, 3.5)
			t.near(d.DefensePvE, 0.5)
		end)
		t.it("el parpadeo se desbloquea con Velocidad 50", function()
			local p = perfil(20)
			p.Stats.Allocated.Speed = 49
			t.equal(Estadisticas.derivadas(p).BlinkUnlocked, false)
			t.equal(Estadisticas.derivadas(p, { Speed = 1 }).BlinkUnlocked, true)
		end)
	end)

	t.describe("Niveles", function()
		t.it("sube varios niveles de golpe y guarda el sobrante", function()
			local p = perfil(1)
			local r = Niveles.sumarXP(p, 121 + 144 + 50)
			t.equal(r.Subidos, 2)
			t.equal(p.Progress.Level, 3)
			t.equal(p.Progress.XP, 50)
			t.equal(r.NivelAnterior, 1)
		end)
		t.it("desbloquea la zona 2 al llegar al nivel 100", function()
			local p = perfil(99)
			t.equal(p.Progress.UnlockedZone, 1)
			local r = Niveles.sumarXP(p, Progresion.xpForLevel(99))
			t.equal(p.Progress.Level, 100)
			t.equal(r.Zona, 2)
			t.equal(r.ZonaAnterior, 1)
		end)
		t.it("la zona desbloqueada nunca baja", function()
			local p = perfil(5)
			p.Progress.UnlockedZone = 4
			Niveles.sumarXP(p, 10)
			t.equal(p.Progress.UnlockedZone, 4)
		end)
		t.it("+5 % de XP por renacimiento", function()
			local p = perfil(1)
			p.Progress.Rebirths = 2
			t.equal(Niveles.sumarXP(p, 100).Ganado, 110)
		end)
		t.it("rechaza XP negativa o no finita", function()
			t.throws(function()
				Niveles.sumarXP(perfil(1), -5)
			end)
			t.throws(function()
				Niveles.sumarXP(perfil(1), 0 / 0)
			end)
		end)
		t.it("barra de progreso", function()
			local p = perfil(1)
			p.Progress.XP = 60
			t.near(Niveles.progreso(p), 60 / 121)
		end)
		t.it("roadmap, fase 2: horas hasta los niveles 10, 50 y 100 con XP simulada", function()
			-- 240 acciones por hora con la XP por acción de B2 (una cada 15 s).
			-- Objetivo del roadmap (D_Roadmap, 3.1): 0,2 / 1,9 / 5,8 h, con un margen del 5 %.
			-- b2_xp_niveles.csv da 6,02 h para el nivel 100 porque divide la XP acumulada por la XP/hora del nivel.
			local p, segundos, marcas = perfil(1), 0, {}
			while p.Progress.Level < 100 do
				Niveles.sumarXP(p, Progresion.xpPerAction(p.Progress.Level))
				segundos = segundos + 15
				if not marcas[p.Progress.Level] then
					marcas[p.Progress.Level] = segundos / 3600
				end
			end
			t.near(marcas[10], 0.2, 0.2 * 0.05, "nivel 10")
			t.near(marcas[50], 1.9, 1.9 * 0.05, "nivel 50")
			t.near(marcas[100], 5.8, 5.8 * 0.05, "nivel 100")
		end)
	end)

	t.describe("Energía y vida", function()
		local d = Estadisticas.derivadas(perfil(1))
		t.it("gastar respeta la energía disponible", function()
			local e = Recursos.nuevo(d)
			t.ok(Recursos.gastar(e, 20, 0))
			t.equal(e.Energy, 80)
			t.ok(not Recursos.gastar(e, 81, 0))
			t.equal(e.Energy, 80)
			t.ok(not Recursos.gastar(e, -5, 0))
		end)
		t.it("pausa de 1,5 s tras gastar y regeneración fuera de combate a 20/s", function()
			local e = Recursos.nuevo(d)
			Recursos.gastar(e, 50, 0)
			Recursos.avanzar(e, 1, 1)
			t.equal(e.Energy, 50)
			Recursos.avanzar(e, 1, 2)
			t.equal(e.Energy, 70)
			Recursos.avanzar(e, 10, 12)
			t.equal(e.Energy, 100, "no pasa del máximo")
		end)
		t.it("en combate regenera 8/s y la vida al 0,5 % en PvE y nada en PvP", function()
			local e = Recursos.nuevo(d)
			Recursos.gastar(e, 50, 0)
			Recursos.marcarCombate(e, 2, "PvE")
			local vida = Recursos.avanzar(e, 1, 3)
			t.equal(e.Energy, 58)
			t.near(vida, 0.005)
			Recursos.marcarCombate(e, 3, "PvP")
			t.equal(Recursos.avanzar(e, 1, 4), 0)
			t.ok(Recursos.enCombate(e, 7.9))
			t.ok(not Recursos.enCombate(e, 8))
			t.near(Recursos.avanzar(e, 1, 9), 0.05)
		end)
		t.it("no regenera energía mientras bloquea", function()
			local e = Recursos.nuevo(d)
			Recursos.gastar(e, 50, 0)
			e.Bloqueando = true
			Recursos.avanzar(e, 5, 10)
			t.equal(e.Energy, 50)
		end)
		t.it("al subir el máximo se conserva la proporción", function()
			local e = Recursos.nuevo(d)
			Recursos.gastar(e, 50, 0)
			local p = perfil(1000)
			p.Stats.Allocated.Energy = 1000
			Recursos.actualizar(e, Estadisticas.derivadas(p))
			t.near(e.Energy, 125)
			t.near(e.MaxEnergy, 250)
		end)
	end)

	t.describe("Monedero", function()
		t.it("sumar y gastar, todo o nada", function()
			local p = perfil(1)
			t.ok(Monedero.sumar(p, 500))
			t.ok(Monedero.gastar(p, 200))
			t.equal(Monedero.saldo(p), 300)
			t.equal(select(2, Monedero.gastar(p, 301)), "sin_saldo")
			t.equal(Monedero.saldo(p), 300)
		end)
		t.it("rechaza cantidades raras y monedas desconocidas", function()
			local p = perfil(1)
			t.equal(select(2, Monedero.sumar(p, -1)), "cantidad")
			t.equal(select(2, Monedero.sumar(p, 1.5)), "cantidad")
			t.equal(select(2, Monedero.sumar(p, 0 / 0)), "cantidad")
			t.equal(select(2, Monedero.sumar(p, math.huge)), "cantidad")
			t.equal(select(2, Monedero.sumar(p, 5, "Robux")), "moneda")
			t.equal(Monedero.saldo(p), 0)
			t.ok(Monedero.sumar(p, 3, "Crystals"))
			t.equal(Monedero.saldo(p, "Crystals"), 3)
		end)
	end)
end
